<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Login launcher for the Wyrd desktop UI (v0.4, ad-hoc and team-signed alike).
  Installed by the installer with @WYRD_APP_PATH@ replaced by the absolute
  path of the installed Wyrd.app (reinstall this agent after moving the app:
  the path is filled once, never re-resolved). Load once with
  `launchctl load -w <this file>`; it copies into ~/Library/LaunchAgents
  only via the install step below, never by hand-editing a live agent.

  A launcher, not a supervisor: RunAtLoad starts the UI once per login and
  nothing respawns it. No respawn key by decision (docs/design/desktop-shell.md,
  open-questions item 7): a quit stays quit, a crash stays dead until the
  next login or a manual launch, and neither ever touches the owner — the
  per-drive owner agents are separate units under the same manager, and
  owner-first ordering is a UI behavior (unavailable until the owner answers,
  explicit reconnect, no restart), never a manager dependency. The Apple
  login-item API was rejected for v0.4: it needs UI-side registration code
  plus a new dependency edge the wyrd-desktop layer gate refuses; the OS
  service manager stays the single parent (OD-06-E).
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>md.enesis.wyrd.desktop</string>
    <key>ProgramArguments</key>
    <array>
    <string>/usr/bin/open</string>
    <string>-a</string>
    <string>@WYRD_APP_PATH@</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>WorkingDirectory</key>
    <string>/</string>
</dict>
</plist>
