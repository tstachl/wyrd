{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wyrd",
  "version": "0.4.0",
  "identifier": "md.enesis.wyrd",
  "build": {
    "frontendDist": "../../apps/desktop/dist",
    "beforeDevCommand": "cd \"$(dirname \"$(cargo locate-project --workspace --message-format plain)\")/apps/desktop\" && bun run dev",
    "beforeBuildCommand": "cd \"$(dirname \"$(cargo locate-project --workspace --message-format plain)\")/apps/desktop\" && bun run build",
    "beforeBundleCommand": "cd \"$(dirname \"$(cargo locate-project --workspace --message-format plain)\")\" && packaging/macos/stage-appex.sh && packaging/macos/stage-cli.sh"
  },
  "app": {
    "windows": [
      {
        "title": "Wyrd",
        "width": 1120,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 18, "y": 22 }
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' asset: data:",
        "font-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-src": "'none'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "files": {
        "PlugIns/WyrdFileProvider.appex": "../../packaging/macos/stage/WyrdFileProvider.appex",
        "Resources/wyrd": "../../packaging/macos/stage/wyrd",
        "Resources/wyrd-supervise": "../../packaging/macos/stage/wyrd-supervise"
      }
    }
  }
}
