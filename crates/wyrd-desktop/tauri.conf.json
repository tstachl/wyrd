{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wyrd",
  "version": "0.4.0",
  "identifier": "md.enesis.wyrd",
  "build": {
    "frontendDist": "../../apps/desktop/dist",
    "beforeDevCommand": "cd ../apps/desktop && bun run dev",
    "beforeBuildCommand": "cd ../apps/desktop && bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "Wyrd",
        "width": 960,
        "height": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
