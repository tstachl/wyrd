{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wyrd",
  "version": "0.4.0",
  "identifier": "md.enesis.wyrd",
  "build": {
    "frontendDist": "../../apps/desktop/dist",
    "beforeDevCommand": "cd \"$(dirname \"$(cargo locate-project --workspace --message-format plain)\")/apps/desktop\" && bun run dev",
    "beforeBuildCommand": "cd \"$(dirname \"$(cargo locate-project --workspace --message-format plain)\")/apps/desktop\" && bun run build",
    "beforeBundleCommand": "cd \"$(dirname \"$(cargo locate-project --workspace --message-format plain)\")\" && packaging/macos/stage-appex.sh"
  },
  "app": {
    "windows": [
      {
        "title": "Wyrd",
        "width": 1120,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "files": {
        "PlugIns/WyrdFileProvider.appex": "../../packaging/macos/stage/WyrdFileProvider.appex"
      }
    }
  }
}
