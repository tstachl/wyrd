# devenv
.devenv*
devenv.local.nix

# direnv
.direnv

# pre-commit
.pre-commit-config.yaml

# Rust build artifacts
target/

# Release archives (built per platform via `nix build .#wyrd-dist`,
# assembled into dist/ at release time; see .ngit/release.yaml)
dist/

# Nix build out-links (`nix build` result symlinks)
result*
# ...but not the frontend's result-shape mirrors (matched by `result*`)
!apps/desktop/src/lib/ipc/results.ts
!apps/desktop/src/lib/ipc/results.test.ts

# Tauri codegen (`tauri-build` output: schemas, embedded context)
crates/wyrd-desktop/gen/

# macOS appex build output (`build-appex.sh`; unsigned, local only)
packaging/macos/fileprovider/build/

# Repo packers (scratch files for review workflows)
repomix*

# Logs
*.log

# JavaScript dependencies (workspace toolchain is bun; lockfile stays tracked)
node_modules/

# OS
.DS_Store

# Env
.env

# Wrangler local state (per-command cache under the repo root)
.wrangler/

# gate skill loaded directly via package
.agents/skills/gate/

# gate-distributed review prompt (generated by the gate skill module on
# shell entry; the tracked wyrd-specific prompt lives at
# .agents/prompts/branch-review-wyrd.md and gate.toml points there)
.agents/prompts/branch-review.md
